class TextRule:
    """Rewrite text files: brand names, exact pairs, and whole code blocks."""

    def __init__(self, globs, pairs=(), protect=(), blocks=(), python=False, required=()):
        self.globs = globs
        self.pairs = list(pairs)
        self.protect = [re.compile(p) for p in protect]
        self.blocks = list(blocks)      # (start marker, end marker, replacement)
        self.python = python
        self.required = required        # patterns that must no longer appear

    def transform(self, text, path):
        out = []
        for line in text.splitlines(keepends=True):
            if any(p.search(line) for p in self.protect):
                out.append(line)
                continue
            # Brand first, so exact pairs match the rebranded text and may
            # still name AnduinOS where it is the true author or source.
            for old, new in BRAND + self.pairs:
                line = line.replace(old, new)
            out.append(line)
        text = "".join(out)
        for start, end, replacement in self.blocks:
            i = text.find(start)
            j = text.find(end, i + len(start)) if i >= 0 else -1
            if i < 0 or j < 0:
                warn(f"{path}: block {start.strip()[:40]!r} not found, left generic")
                continue
            text = text[:i] + replacement + text[j:]
        for pattern in self.required:
            if pattern in text:
                raise RuntimeError(f"{path}: {pattern!r} still present after rebranding")
        return text


class RecolorRule(TextRule):
    """Turn the dark neutral greys of a stylesheet into Decodium navy.

    Fluent's dark GTK 3/4 and GNOME Shell styles are built from a handful of
    greys (#202020, #2B2B2B, #333333, #3C3C3C...). Each grey of level v in
    the dark range becomes (0.55 v, 0.75 v, 1.15 v): #202020 -> #121825 and
    #3C3C3C -> #212D45, i.e. the Decodium 4 "Ocean Blue" surfaces.
    Lighter greys (text, borders) and every non-grey colour are kept.
    """

    HEX = re.compile(r"#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3})(?![0-9a-zA-Z_-])")
    RGB = re.compile(r"(rgba?\()\s*(\d{1,3}),\s*(\d{1,3}),\s*(\d{1,3})")
    DARK = range(0x10, 0x5B)

    @staticmethod
    def navy(v):
        return round(v * 0.55), round(v * 0.75), min(255, round(v * 1.15))

    def _hex(self, m):
        h = m.group(1)
        if len(h) == 3:
            rgb, alpha = [int(c * 2, 16) for c in h], ""
        else:
            rgb, alpha = [int(h[i:i + 2], 16) for i in (0, 2, 4)], h[6:]
        if rgb[0] == rgb[1] == rgb[2] and rgb[0] in self.DARK:
            r, g, b = self.navy(rgb[0])
            return f"#{r:02X}{g:02X}{b:02X}{alpha}"
        return m.group(0)

    def _rgb(self, m):
        v = [int(m.group(i)) for i in (2, 3, 4)]
        if v[0] == v[1] == v[2] and v[0] in self.DARK:
            r, g, b = self.navy(v[0])
            return f"{m.group(1)}{r}, {g}, {b}"
        return m.group(0)

    def transform(self, text, path):
        text = super().transform(text, path)
        return self.RGB.sub(self._rgb, self.HEX.sub(self._hex, text))


