[Unit]
Description=Decodium AI Agent - Local LLM API Server
Documentation=https://github.com/iu8lmc/DecodiumOS
After=network.target
Wants=network.target

[Service]
Type=simple
User=decodium-ai
Group=decodium-ai
ExecStart=/usr/bin/decodium-ai --server --server-port 8080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=decodium-ai-server

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/usr/lib/decodium-ai/models
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits
MemoryMax=4G
CPUQuota=200%

[Install]
WantedBy=multi-user.target