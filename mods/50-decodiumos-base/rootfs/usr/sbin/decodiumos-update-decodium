#!/usr/bin/python3
"""Install or update Decodium from its GitHub releases as a dpkg package.

Upstream publishes Decodium for Linux as AppImages. This tool downloads the
AppImage for this architecture, verifies it against the SHA-256 published
with the release, unpacks it under /opt/decodium (so no FUSE is needed at run
time) and installs the result as the "decodium" package through apt, so it
can be upgraded, pinned or removed like any other package.

    sudo decodiumos-update-decodium               # newest release
    sudo decodiumos-update-decodium --version v1.0.627
    decodiumos-update-decodium --check            # compare, change nothing
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request

CONFIG = "/etc/decodiumos/decodium.conf"
DEFAULT_REPO = "iu8lmc/Decodium-4.0-Core-Shannon"
PACKAGE = "decodium"
INSTALL_DIR = "opt/decodium"
DESKTOP_FILE = "decodium.desktop"
MAINTAINER = "DecodiumOS <noreply@decodiumos.invalid>"
APPIMAGE_ARCH = {"amd64": "x86_64", "arm64": "aarch64"}


def fail(message):
    print(f"decodiumos-update-decodium: {message}", file=sys.stderr)
    sys.exit(1)


def load_config():
    config = {"REPO": DEFAULT_REPO, "VERSION": "latest"}
    try:
        with open(CONFIG, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip().strip("\"'")
    except FileNotFoundError:
        pass
    return config


def open_url(url, accept=None):
    headers = {"User-Agent": "decodiumos-update-decodium"}
    if accept:
        headers["Accept"] = accept
    token = os.environ.get("GITHUB_TOKEN")
    if token and url.startswith("https://api.github.com/"):
        headers["Authorization"] = f"Bearer {token}"
    return urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60)


def fetch_release(repo, version):
    """Return the GitHub release JSON for "latest" or a tag (with or without v)."""
    if version == "latest":
        candidates = ["latest"]
    else:
        candidates = [f"tags/{version}"]
        if not version.startswith("v"):
            candidates.append(f"tags/v{version}")
    for path in candidates:
        url = f"https://api.github.com/repos/{repo}/releases/{path}"
        try:
            with open_url(url, "application/vnd.github+json") as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            if error.code != 404:
                fail(f"GitHub API error {error.code} for {url}")
        except urllib.error.URLError as error:
            fail(f"cannot reach GitHub: {error.reason}")
    fail(f"release {version!r} not found in {repo}")


def pick_assets(release, appimage_arch):
    suffix = f"-linux-{appimage_arch}.AppImage"
    images = [a for a in release["assets"] if a["name"].endswith(suffix)]
    if len(images) != 1:
        fail(f"release {release['tag_name']} has {len(images)} assets ending in {suffix}")
    image = images[0]
    sums = [a for a in release["assets"] if a["name"] == image["name"] + ".sha256.txt"]
    if not sums:
        fail(f"release {release['tag_name']} publishes no checksum for {image['name']}; refusing")
    return image, sums[0]


def package_version(tag):
    version = tag[1:] if tag.startswith("v") else tag
    if not re.fullmatch(r"[0-9][A-Za-z0-9.+~-]*", version):
        fail(f"tag {tag!r} is not usable as a Debian version")
    return version


def installed_version():
    result = subprocess.run(
        ["dpkg-query", "-W", "-f=${db:Status-Abbrev}|${Version}", PACKAGE],
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0 or not result.stdout.startswith("ii"):
        return None
    return result.stdout.split("|", 1)[1]


def download(url, destination):
    digest = hashlib.sha256()
    with open_url(url) as response, open(destination, "wb") as handle:
        while chunk := response.read(1 << 20):
            handle.write(chunk)
            digest.update(chunk)
    return digest.hexdigest()


def expected_sha256(url):
    with open_url(url) as response:
        text = response.read().decode("utf-8", "replace").strip()
    value = text.split()[0].lower() if text else ""
    if not re.fullmatch(r"[0-9a-f]{64}", value):
        fail(f"malformed checksum file at {url}")
    return value


def squashfs_offset(path):
    """The AppImage payload starts right after the ELF section header table."""
    with open(path, "rb") as handle:
        head = handle.read(64)
        if head[:4] != b"\x7fELF":
            fail(f"{path} is not an ELF AppImage")
        endian = "<" if head[5] == 1 else ">"
        if head[4] == 2:
            (shoff,) = struct.unpack_from(endian + "Q", head, 0x28)
            shentsize, shnum = struct.unpack_from(endian + "HH", head, 0x3A)
        else:
            (shoff,) = struct.unpack_from(endian + "I", head, 0x20)
            shentsize, shnum = struct.unpack_from(endian + "HH", head, 0x2E)
        offset = shoff + shentsize * shnum
        handle.seek(offset)
        if handle.read(4) != b"hsqs":
            fail(f"no SquashFS payload found in {path}")
    return offset


def stage_package(appimage, workdir, *, version, deb_arch, repo, release, asset, sha256):
    root = os.path.join(workdir, "pkg")
    appdir = os.path.join(root, INSTALL_DIR)
    os.makedirs(os.path.dirname(appdir))
    subprocess.run(
        ["unsquashfs", "-no-progress", "-o", str(squashfs_offset(appimage)), "-d", appdir, appimage],
        check=True, stdout=subprocess.DEVNULL,
    )
    apprun = os.path.join(appdir, "AppRun")
    if not os.access(apprun, os.X_OK):
        fail("the AppImage has no executable AppRun")
    os.chmod(appdir, 0o755)

    # AppRun resolves its own location with readlink -f, so a symlink on PATH works.
    bindir = os.path.join(root, "usr/bin")
    os.makedirs(bindir)
    os.symlink(f"/{INSTALL_DIR}/AppRun", os.path.join(bindir, "decodium"))

    desktop_sources = [
        name for name in os.listdir(appdir)
        if name.endswith(".desktop") and os.path.isfile(os.path.join(appdir, name))
    ]
    if not desktop_sources:
        fail("the AppImage ships no .desktop file")
    with open(os.path.join(appdir, desktop_sources[0]), encoding="utf-8") as handle:
        entry = [line for line in handle.read().splitlines() if not line.startswith("X-AppImage-")]
    applications = os.path.join(root, "usr/share/applications")
    os.makedirs(applications)
    # A fixed file name keeps the taskbar pin in the dconf defaults valid.
    with open(os.path.join(applications, DESKTOP_FILE), "w", encoding="utf-8") as handle:
        handle.write("\n".join(entry) + "\n")

    icons = os.path.join(appdir, "usr/share/icons/hicolor")
    for directory, _, files in os.walk(icons):
        for name in files:
            source = os.path.join(directory, name)
            if not name.startswith("decodium") or os.path.islink(source):
                continue
            target = os.path.join(root, "usr/share/icons/hicolor", os.path.relpath(source, icons))
            os.makedirs(os.path.dirname(target), exist_ok=True)
            shutil.copy2(source, target)

    docdir = os.path.join(root, "usr/share/doc", PACKAGE)
    os.makedirs(docdir)
    with open(os.path.join(docdir, "README.DecodiumOS"), "w", encoding="utf-8") as handle:
        handle.write(
            f"Decodium {release['tag_name']} packaged by decodiumos-update-decodium.\n\n"
            f"Source:  {asset['browser_download_url']}\n"
            f"SHA-256: {sha256}\n"
            f"Release: {release['html_url']}\n"
        )

    size_kib = 0
    for directory, _, files in os.walk(root):
        for name in files:
            path = os.path.join(directory, name)
            if not os.path.islink(path):
                size_kib += (os.path.getsize(path) + 1023) // 1024

    debian = os.path.join(root, "DEBIAN")
    os.makedirs(debian)
    with open(os.path.join(debian, "control"), "w", encoding="utf-8") as handle:
        handle.write(
            f"Package: {PACKAGE}\n"
            f"Version: {version}\n"
            f"Architecture: {deb_arch}\n"
            f"Maintainer: {MAINTAINER}\n"
            f"Installed-Size: {size_kib}\n"
            "Section: hamradio\n"
            "Priority: optional\n"
            f"Homepage: https://github.com/{repo}\n"
            "Description: FT2/FT8/FT4/Q65 weak-signal digital modes for amateur radio\n"
            f" Decodium {release['tag_name']} from the official AppImage release\n"
            f" {asset['name']}, verified against its published SHA-256 and\n"
            " unpacked under /opt/decodium by DecodiumOS.\n"
        )
    return root


def main():
    # Staged directories become package metadata; never inherit a strict umask.
    os.umask(0o022)
    config = load_config()
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--repo", default=config["REPO"], help="GitHub OWNER/NAME (default: %(default)s)")
    parser.add_argument("--version", default=config["VERSION"], help="'latest' or a release tag (default: %(default)s)")
    parser.add_argument("--check", action="store_true", help="only report installed and available versions")
    parser.add_argument("--force", action="store_true", help="reinstall or downgrade to the requested version")
    parser.add_argument("--output-dir", help="build the .deb into this directory instead of installing it")
    args = parser.parse_args()

    deb_arch = subprocess.run(
        ["dpkg", "--print-architecture"], capture_output=True, text=True, check=True
    ).stdout.strip()
    if deb_arch not in APPIMAGE_ARCH:
        fail(f"Decodium publishes no AppImage for {deb_arch}")

    release = fetch_release(args.repo, args.version)
    version = package_version(release["tag_name"])
    current = installed_version()
    print(f"Decodium installed: {current or 'no'}; {args.version}: {version} ({args.repo})")
    if args.check:
        return
    if current == version and not args.force and not args.output_dir:
        print("Already up to date.")
        return
    if os.geteuid() != 0 and not args.output_dir:
        fail("installing needs root: run it with sudo")

    image, checksum = pick_assets(release, APPIMAGE_ARCH[deb_arch])
    with tempfile.TemporaryDirectory(prefix="decodium-", dir="/var/tmp") as workdir:
        appimage = os.path.join(workdir, image["name"])
        print(f"Downloading {image['name']} ({image['size'] // (1 << 20)} MiB)...")
        actual = download(image["browser_download_url"], appimage)
        expected = expected_sha256(checksum["browser_download_url"])
        if actual != expected:
            fail(f"SHA-256 mismatch for {image['name']}: got {actual}, expected {expected}")
        print(f"SHA-256 verified: {actual}")

        root = stage_package(
            appimage, workdir, version=version, deb_arch=deb_arch, repo=args.repo,
            release=release, asset=image, sha256=actual,
        )
        deb = os.path.join(args.output_dir or workdir, f"{PACKAGE}_{version}_{deb_arch}.deb")
        subprocess.run(["dpkg-deb", "--root-owner-group", "--build", root, deb], check=True)
        if args.output_dir:
            print(f"Built {deb}")
            return
        env = dict(os.environ, DEBIAN_FRONTEND=os.environ.get("DEBIAN_FRONTEND", "noninteractive"))
        subprocess.run(["apt-get", "install", "-y", "--allow-downgrades", deb], check=True, env=env)
    print(f"Decodium {version} installed.")


if __name__ == "__main__":
    main()
